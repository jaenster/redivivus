#!/usr/bin/env bash
# oracle - the msvc8 ASM-matching oracle's single entry point.
#
#   oracle setup              fetch Game.exe 1.14d, build the VC8 toolchain (once)
#   oracle build [-j N] [TU]  translate + compile, incremental (TU = path substring)
#   oracle map                derive evidence/funcmap.tsv (our function -> address)
#   oracle libmap             derive evidence/libmap.tsv (the linked runtime's functions -> address)
#   oracle audit [--data]     byte-compare every mapped function: evidence/audit.tsv
#                             (--data, or ORACLE_DATA=1: then the data audit too)
#   oracle data [extents|strings|audit] byte-compare our initialised data with the original's:
#                             evidence/data-audit.tsv (extents: re-read Ghidra's data
#                             extents from a codegen snapshot, evidence/dataextent.tsv;
#                             strings: its untyped strings, evidence/datastrings.tsv)
#   oracle diff <name|addr>   one function, ours beside the original
#   oracle all                build, map, libmap, audit
#   oracle quick [--verify]   all, doing only what changed; prints gained/lost MATCH
#                             (--verify: then the full run too, and diff the two)
#   oracle fix [PATTERN]      run every fixer over the tree (scripts/fix_all.py), then build, audit
#   oracle crt                re-derive evidence/crtmap.tsv (the linked CRT)
#   oracle ref                re-carve the original into functions (cached; automatic; zig/)
#   oracle rich <pe>          decode a PE's Rich header
#   oracle compid <obj|lib>   the tool stamps inside objects / libraries
#
# Settings are environment variables (scripts/env.sh): ORACLE_VC (sp1|rtm),
# ORACLE_CFLAGS, ORACLE_DRIVE, VC8_TOOLCHAIN, ORACLE_CACHE (the shared
# compile cache, scripts/objcache.py), ORACLE_NOCACHE=1 (a full run). A non-default ORACLE_VC or
# ORACLE_CFLAGS is an experiment: it builds in build/experiment-*/, and its
# audit uses the baseline's evidence/funcmap.tsv (the same pairs, other code)
# and writes beside its objects. Evidence/ only ever holds the baseline.
set -euo pipefail
. "$(dirname "$0")/scripts/env.sh"

# The carve: zig/ (refimage in Zig, about a second) when zig is installed, else refimage.py
# (the same rows, 20+ minutes).
carve() {
    if command -v zig >/dev/null 2>&1; then
        local bin="$ORACLE_ROOT/zig/zig-out/bin/refimage"
        (cd "$ORACLE_ROOT/zig" && zig build --release=fast)
        local ref="$ORACLE_ROOT/build/ref"
        mkdir -p "$ref"
        "$bin" "$REFERENCE_EXE" "$ref/functions.tsv.new"
        # model.pkl decodes the carve's functions: a different carve makes it stale.
        cmp -s "$ref/functions.tsv.new" "$ref/functions.tsv" || rm -f "$ref/model.pkl"
        mv "$ref/functions.tsv.new" "$ref/functions.tsv"
    else
        rm -f "$ORACLE_ROOT/build/ref/model.pkl"
        oracle_python "$SCRIPTS/refimage.py" "$@"
    fi
}

ensure_ref() {
    [ -f "$REFERENCE_EXE" ] || "$SCRIPTS/fetch_reference.sh"
    [ -f "$ORACLE_ROOT/build/ref/functions.tsv" ] || carve
}

is_experiment() { [ "$ORACLE_VC" != sp1 ] || [ -n "${ORACLE_CFLAGS:-}" ]; }

cmd="${1:-help}"; [ $# -gt 0 ] && shift
case "$cmd" in
    setup)  "$SCRIPTS/fetch_reference.sh"; "$SCRIPTS/setup_toolchain.sh" ;;
    build)  oracle_python "$SCRIPTS/build.py" "$@" ;;
    ref)    [ -f "$REFERENCE_EXE" ] || "$SCRIPTS/fetch_reference.sh"; carve "$@" ;;
    crt)    ensure_ref; oracle_python "$SCRIPTS/crtmap.py" "$@" ;;
    map)    ensure_ref
            if is_experiment; then
                echo "oracle map: not in an experiment - an A/B audit must use the baseline's map" >&2; exit 2
            fi
            oracle_python "$SCRIPTS/funcmap.py" "$@" ;;
    libmap) ensure_ref
            if is_experiment; then
                echo "oracle libmap: not in an experiment - an A/B audit must use the baseline's map" >&2; exit 2
            fi
            oracle_python "$SCRIPTS/libmap.py" "$@" ;;
    audit)  ensure_ref
            with_data="${ORACLE_DATA:-0}"
            args=()
            for a in "$@"; do
                if [ "$a" = --data ]; then with_data=1; else args+=("$a"); fi
            done
            if is_experiment; then
                # Same pairs as the baseline, this experiment's objects: a fair A/B.
                echo "*** experiment: auditing $ORACLE_BUILD/obj -> $ORACLE_BUILD/audit.tsv" >&2
                oracle_python "$SCRIPTS/audit.py" --out "$ORACLE_BUILD/audit.tsv" ${args[@]+"${args[@]}"}
            else
                oracle_python "$SCRIPTS/audit.py" ${args[@]+"${args[@]}"}
            fi
            if [ "$with_data" = 1 ]; then
                # After the function audit: it rewrites the datamap the data audit pairs by.
                oracle_python "$SCRIPTS/datamatch.py" audit
            fi ;;
    data)   ensure_ref; oracle_python "$SCRIPTS/datamatch.py" "${@:-audit}" ;;
    diff)   ensure_ref; oracle_python "$SCRIPTS/asmdiff.py" "$@" ;;
    fix)    if is_experiment; then echo "oracle fix: not in an experiment - it edits the tree" >&2; exit 2; fi
            ensure_ref; oracle_python "$SCRIPTS/fix_all.py" "$@" ;;
    all)    "$0" build "$@"; "$0" map; "$0" libmap; "$0" audit ;;
    quick)  ensure_ref
            if is_experiment; then echo "oracle quick: not in an experiment" >&2; exit 2; fi
            oracle_python "$SCRIPTS/quick.py" "$@" ;;
    rich)   oracle_python "$SCRIPTS/decode_rich_header.py" "${1:-$REFERENCE_EXE}" ;;
    compid) oracle_python "$SCRIPTS/compid.py" "$@" ;;
    *)      sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//' ;;
esac
