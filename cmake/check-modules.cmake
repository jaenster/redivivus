# Source/modules.cmake against project.json "modules": the module table is edited in
# project.json, and modules.cmake is generated from it. A difference means the table
# was changed without regenerating (or the other way round), and the build would
# follow a graph the table no longer states. Checked at configure time.
#
#   d2_check_modules(<project.json>)   after include(Source/modules.cmake)
#
# Compares, per Windows module: dir, kind, strict, the unit order rule, the direct
# dependencies in order, the modules named by exceptions; and the link order of the
# whole table.

function(d2_check_modules json_path)
    if(NOT EXISTS "${json_path}")
        message(STATUS "module table: no ${json_path}; modules.cmake not checked")
        return()
    endif()
    file(READ "${json_path}" json)
    string(JSON modules ERROR_VARIABLE err GET "${json}" modules)
    if(err)
        message(FATAL_ERROR "module table: ${json_path} has no \"modules\" object: ${err}")
    endif()
    string(JSON count LENGTH "${modules}")
    set(problems)
    set(order)
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
        string(JSON name MEMBER "${modules}" ${i})
        string(JSON m GET "${modules}" "${name}")
        string(JSON target ERROR_VARIABLE noerr GET "${m}" target)
        if(NOT noerr AND target STREQUAL "mac")
            if(name IN_LIST D2_MODULES)
                list(APPEND problems "${name}: a Mac module in modules.cmake")
            endif()
            continue()
        endif()
        if(NOT name IN_LIST D2_MODULES)
            list(APPEND problems "${name}: in project.json, not in modules.cmake")
            continue()
        endif()
        string(JSON dir GET "${m}" dir)
        string(JSON kind GET "${m}" kind)
        string(JSON link GET "${m}" linkOrder)
        string(JSON strict ERROR_VARIABLE noerr GET "${m}" strict)
        if(noerr OR NOT strict)
            set(strict OFF)
        else()
            set(strict ON)
        endif()
        if(NOT dir STREQUAL "${D2_MODULE_${name}_DIR}")
            list(APPEND problems "${name}: dir ${dir} in project.json, ${D2_MODULE_${name}_DIR} in modules.cmake")
        endif()
        if(NOT kind STREQUAL "${D2_MODULE_${name}_KIND}")
            list(APPEND problems "${name}: kind ${kind} in project.json, ${D2_MODULE_${name}_KIND} in modules.cmake")
        endif()
        if(NOT strict STREQUAL "${D2_MODULE_${name}_STRICT}")
            list(APPEND problems "${name}: strict ${strict} in project.json, ${D2_MODULE_${name}_STRICT} in modules.cmake")
        endif()
        string(JSON unit_order ERROR_VARIABLE noerr GET "${m}" unitOrder)
        if(noerr)
            set(unit_order "path")
        endif()
        set(cmake_unit_order "${D2_MODULE_${name}_UNIT_ORDER}")
        if(cmake_unit_order STREQUAL "")
            set(cmake_unit_order "path")
        endif()
        if(NOT unit_order STREQUAL cmake_unit_order)
            list(APPEND problems "${name}: unitOrder ${unit_order} in project.json, ${cmake_unit_order} in modules.cmake")
        endif()
        set(deps)
        string(JSON ndeps ERROR_VARIABLE noerr LENGTH "${m}" dependencies)
        if(NOT noerr AND ndeps GREATER 0)
            math(EXPR dl "${ndeps} - 1")
            foreach(j RANGE ${dl})
                string(JSON d GET "${m}" dependencies ${j} module)
                if(d IN_LIST D2_MODULES)
                    list(APPEND deps "${d}")
                endif()
            endforeach()
        endif()
        if(NOT "${deps}" STREQUAL "${D2_MODULE_${name}_DEPENDS}")
            list(APPEND problems "${name}: dependencies [${deps}] in project.json, [${D2_MODULE_${name}_DEPENDS}] in modules.cmake")
        endif()
        set(exc)
        string(JSON nexc ERROR_VARIABLE noerr LENGTH "${m}" exceptions)
        if(NOT noerr AND nexc GREATER 0)
            math(EXPR el "${nexc} - 1")
            foreach(j RANGE ${el})
                string(JSON t GET "${m}" exceptions ${j} to)
                if(NOT t IN_LIST exc)
                    list(APPEND exc "${t}")
                endif()
            endforeach()
        endif()
        if(NOT "${exc}" STREQUAL "${D2_MODULE_${name}_EXCEPTIONS}")
            list(APPEND problems "${name}: exceptions [${exc}] in project.json, [${D2_MODULE_${name}_EXCEPTIONS}] in modules.cmake")
        endif()
        # Zero-padded so a string sort is the numeric one.
        string(LENGTH "${link}" len)
        math(EXPR pad "8 - ${len}")
        string(REPEAT "0" ${pad} zeros)
        list(APPEND order "${zeros}${link}|${name}")
    endforeach()
    foreach(name IN LISTS D2_MODULES)
        string(JSON present ERROR_VARIABLE noerr GET "${modules}" "${name}")
        if(noerr)
            list(APPEND problems "${name}: in modules.cmake, not in project.json")
        endif()
    endforeach()
    list(SORT order)
    set(ordered)
    foreach(o IN LISTS order)
        string(REGEX REPLACE "^[0-9]+\\|" "" o "${o}")
        list(APPEND ordered "${o}")
    endforeach()
    if(NOT "${ordered}" STREQUAL "${D2_MODULES}")
        list(APPEND problems "link order [${ordered}] in project.json, [${D2_MODULES}] in modules.cmake")
    endif()
    if(problems)
        string(REPLACE ";" "\n  " text "${problems}")
        message(FATAL_ERROR "module table: Source/modules.cmake does not match ${json_path}:\n  ${text}\n"
            "modules.cmake is generated from project.json \"modules\"; regenerate it after changing the table.")
    endif()
    list(LENGTH D2_MODULES n)
    message(STATUS "module table: modules.cmake matches project.json (${n} modules)")
endfunction()
