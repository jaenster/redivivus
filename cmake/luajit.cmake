# LuaJIT (3rdparty/luajit, upstream source at the commit in its PROVENANCE) as the imported
# static library target `luajit`, built by LuaJIT's own Makefile for whatever this toolchain
# targets. cmake/luajit-make.sh runs the make, out of tree in <build>/luajit, and picks the
# host compiler for LuaJIT's build-time tools (see the script for the docker fallback that a
# 32-bit target needs on a Mac).
#
# Include once. Consumers include "lua.hpp" through the target's include directory.

option(D2_LUAJIT_CHECKHOOK
    "Build LuaJIT with LUAJIT_ENABLE_CHECKHOOK: compiled traces notice a hook set from another thread, which the Lua host's time budget depends on." ON)

if(NOT D2_ROOT)
    get_filename_component(D2_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
endif()
set(D2_LUAJIT_SRC "${D2_ROOT}/3rdparty/luajit")
set(D2_LUAJIT_OUT "${CMAKE_BINARY_DIR}/luajit")
set(D2_LUAJIT_LIB "${D2_LUAJIT_OUT}/src/libluajit.a")

# The cross prefix: the toolchain files name it D2_TOOL_PREFIX; otherwise derive it from the C
# compiler ("i686-w64-mingw32-gcc" -> "i686-w64-mingw32-"); a native build has none.
set(_lj_cross "")
if(CMAKE_CROSSCOMPILING)
    if(D2_TOOL_PREFIX)
        set(_lj_cross "${D2_TOOL_PREFIX}")
    else()
        get_filename_component(_lj_cc "${CMAKE_C_COMPILER}" NAME)
        string(REGEX REPLACE "(gcc|cc|clang)(-[0-9.]+)?(\\.exe)?$" "" _lj_cross "${_lj_cc}")
    endif()
endif()
if(WIN32)
    set(_lj_sys Windows)
elseif(APPLE)
    set(_lj_sys Darwin)
else()
    set(_lj_sys Linux)
endif()
math(EXPR _lj_bits "${CMAKE_SIZEOF_VOID_P} * 8")
set(_lj_xcflags "")
if(D2_LUAJIT_CHECKHOOK)
    set(_lj_xcflags "-DLUAJIT_ENABLE_CHECKHOOK")
endif()

# A native build hands its own compiler and flags to the make (a -m32 build on x86-64 Linux).
set(_lj_cc "")
if(NOT _lj_cross)
    string(STRIP "${CMAKE_C_COMPILER} ${CMAKE_C_FLAGS}" _lj_cc)
endif()

file(GLOB_RECURSE _lj_inputs CONFIGURE_DEPENDS "${D2_LUAJIT_SRC}/src/*")
add_custom_command(
    OUTPUT "${D2_LUAJIT_LIB}"
    COMMAND bash "${D2_ROOT}/cmake/luajit-make.sh" --src "${D2_LUAJIT_SRC}" --out "${D2_LUAJIT_OUT}"
            --cross "${_lj_cross}" --target-sys ${_lj_sys} --bits ${_lj_bits} --xcflags "${_lj_xcflags}"
            --cc "${_lj_cc}"
    DEPENDS ${_lj_inputs} "${D2_ROOT}/cmake/luajit-make.sh" "${CMAKE_CURRENT_LIST_FILE}"
    COMMENT "LuaJIT: upstream make for ${_lj_sys} ${_lj_bits}-bit ${_lj_cross}"
    USES_TERMINAL VERBATIM)
add_custom_target(luajit_make DEPENDS "${D2_LUAJIT_LIB}")

# The headers are used from the build copy: luajit.h (with the version) is generated by the make.
# A consumer also needs add_dependencies(<it> luajit_make) so the make runs before it compiles.
file(MAKE_DIRECTORY "${D2_LUAJIT_OUT}/src")
add_library(luajit STATIC IMPORTED GLOBAL)
set_target_properties(luajit PROPERTIES
    IMPORTED_LOCATION "${D2_LUAJIT_LIB}"
    INTERFACE_INCLUDE_DIRECTORIES "${D2_LUAJIT_OUT}/src")
add_dependencies(luajit luajit_make)
if(_lj_sys STREQUAL Linux)
    set_property(TARGET luajit PROPERTY INTERFACE_LINK_LIBRARIES m dl)
endif()
message(STATUS "LuaJIT: ${_lj_sys} ${_lj_bits}-bit, cross '${_lj_cross}', XCFLAGS '${_lj_xcflags}' -> ${D2_LUAJIT_LIB}")
