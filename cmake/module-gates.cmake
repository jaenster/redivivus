# The module gate report: every include a module makes of a module it may not see.
#
#   cmake -DROOT=<tree> -DOUT=<dir> -P cmake/module-gates.cmake
#
# Reads the module table (Source/modules.cmake, generated from project.json
# "modules"), follows each translation unit's quoted includes through the tree,
# and charges every header it reaches to the module that owns the header. A
# header of a module outside the unit's D2_MODULE_<m>_SEES is a wrong-direction
# include; one of a module the unit's module names in D2_MODULE_<m>_EXCEPTIONS is
# a documented exception. Source/globals/ is the shared root every module may include:
# what it includes is the root's, and is counted on its own (via-root).
#
# A module another module may see is still reached through one header: its public
# header (D2_MODULE_<m>_PUBLIC). A file that includes any other header of a module it
# sees is an internal include, charged to the including file's module; the public
# headers' own includes follow the import graph, so they never are one. A header of a
# module the file's module only loads (D2_MODULE_<m>_LOADS) is listed as a load
# include instead: the host sees the loaded module's interface, which is not its
# public header (that one brings the loaded module's imports along).
#
# Writes <OUT>/module-gates.tsv (one row per module pair) and
# <OUT>/module-gates-summary.tsv (one row per module), and prints the summary.
# A module with D2_MODULE_<m>_STRICT ON fails here as soon as it has a violation or
# an internal include; the others only report.

cmake_minimum_required(VERSION 3.16)
if(NOT ROOT OR NOT OUT)
    message(FATAL_ERROR "usage: cmake -DROOT=<tree> -DOUT=<dir> -P module-gates.cmake")
endif()
# A relative root resolves against the caller's directory, not the script's.
get_filename_component(ROOT "${ROOT}" ABSOLUTE)
include("${ROOT}/Source/modules.cmake")
file(MAKE_DIRECTORY "${OUT}")

# path -> owning module, as variables keyed by a C identifier of the path.
macro(_key var path)
    string(MAKE_C_IDENTIFIER "${path}" ${var})
endmacro()

set(_all_files)
set(_tus)
foreach(m IN LISTS D2_MODULES)
    set(dir "${D2_MODULE_${m}_DIR}")
    if(NOT IS_DIRECTORY "${ROOT}/${dir}")
        continue()
    endif()
    file(GLOB_RECURSE files RELATIVE "${ROOT}" LIST_DIRECTORIES false
        "${ROOT}/${dir}/*.h" "${ROOT}/${dir}/*.inl" "${ROOT}/${dir}/*.cpp" "${ROOT}/${dir}/*.c")
    foreach(f IN LISTS files)
        _key(k "${f}")
        set(OWNER_${k} "${m}")
        list(APPEND _all_files "${f}")
        if(f MATCHES "\\.(cpp|c)$")
            list(APPEND _tus "${f}")
            set(TUMOD_${k} "${m}")
        endif()
    endforeach()
    # The unit holding the module's globals is compiled into the module.
    if(D2_MODULE_${m}_DATA AND EXISTS "${ROOT}/${D2_MODULE_${m}_DATA}")
        _key(k "${D2_MODULE_${m}_DATA}")
        set(TUMOD_${k} "${m}")
        list(APPEND _tus "${D2_MODULE_${m}_DATA}")
    endif()
endforeach()
if(NOT _tus)
    message(FATAL_ERROR "module gates: no translation unit found under ${ROOT}")
endif()
file(GLOB _root_files RELATIVE "${ROOT}" LIST_DIRECTORIES false "${ROOT}/Source/globals/*.h" "${ROOT}/Source/globals/*.cpp")
foreach(f IN LISTS _root_files)
    _key(k "${f}")
    set(OWNER_${k} "(root)")
    list(APPEND _all_files "${f}")
endforeach()

# Direct quoted includes of each file, resolved to tree paths (rooted first, then
# beside the including file, as the compiler searches).
foreach(f IN LISTS _all_files)
    _key(k "${f}")
    file(STRINGS "${ROOT}/${f}" lines REGEX "^[ \t]*#[ \t]*include[ \t]*\"")
    get_filename_component(d "${f}" DIRECTORY)
    set(incs)
    foreach(l IN LISTS lines)
        string(REGEX REPLACE "^[ \t]*#[ \t]*include[ \t]*\"([^\"]+)\".*$" "\\1" inc "${l}")
        if(EXISTS "${ROOT}/${inc}" AND NOT IS_DIRECTORY "${ROOT}/${inc}")
            list(APPEND incs "${inc}")
        elseif(d AND EXISTS "${ROOT}/${d}/${inc}")
            get_filename_component(abs "${ROOT}/${d}/${inc}" ABSOLUTE)
            file(RELATIVE_PATH rel "${ROOT}" "${abs}")
            list(APPEND incs "${rel}")
        endif()
    endforeach()
    set(INC_${k} "${incs}")
endforeach()

# Closure of a header without crossing into the root: memoised, cycle-safe.
function(_closure path out)
    _key(k "${path}")
    get_property(done GLOBAL PROPERTY CL_DONE_${k} SET)
    if(done)
        get_property(r GLOBAL PROPERTY CL_${k})
        set(${out} "${r}" PARENT_SCOPE)
        return()
    endif()
    set_property(GLOBAL PROPERTY CL_DONE_${k} 1)
    set_property(GLOBAL PROPERTY CL_${k} "")
    set(r)
    foreach(inc IN LISTS INC_${k})
        _key(ik "${inc}")
        if("${OWNER_${ik}}" STREQUAL "(root)")
            continue()
        endif()
        list(APPEND r "${inc}")
        _closure("${inc}" sub)
        list(APPEND r ${sub})
    endforeach()
    if(r)
        list(REMOVE_DUPLICATES r)
    endif()
    set_property(GLOBAL PROPERTY CL_${k} "${r}")
    set(${out} "${r}" PARENT_SCOPE)
endfunction()

# Everything the root pulls in (globals.h includes headers of every module).
set(_root_closure)
foreach(f IN LISTS _root_files)
    if(f MATCHES "\\.h$")
        _key(k "${f}")
        foreach(inc IN LISTS INC_${k})
            list(APPEND _root_closure "${inc}")
            _closure("${inc}" sub)
            list(APPEND _root_closure ${sub})
        endforeach()
    endif()
endforeach()
if(_root_closure)
    list(REMOVE_DUPLICATES _root_closure)
endif()

# Per translation unit: what it reaches, and who owns it.
set(_pairs)
foreach(tu IN LISTS _tus)
    _key(tk "${tu}")
    set(m "${TUMOD_${tk}}")
    if(D2_MODULE_${m}_KIND STREQUAL "ours")
        continue()
    endif()
    set(reach)
    set(uses_root OFF)
    foreach(inc IN LISTS INC_${tk})
        _key(ik "${inc}")
        if("${OWNER_${ik}}" STREQUAL "(root)")
            set(uses_root ON)
            continue()
        endif()
        list(APPEND reach "${inc}")
        _closure("${inc}" sub)
        list(APPEND reach ${sub})
    endforeach()
    if(NOT uses_root)
        foreach(h IN LISTS reach)
            _key(hk "${h}")
            if(INC_${hk} MATCHES "(^|;)Source/globals/")
                set(uses_root ON)
                break()
            endif()
        endforeach()
    endif()
    if(uses_root)
        set(USES_ROOT_${m} ON)
    endif()
    if(reach)
        list(REMOVE_DUPLICATES reach)
    endif()
    foreach(h IN LISTS reach)
        _key(hk "${h}")
        set(o "${OWNER_${hk}}")
        if(NOT o OR o STREQUAL m OR o STREQUAL "(root)")
            continue()
        endif()
        if(o IN_LIST D2_MODULE_${m}_EXCEPTIONS)
            set(verdict excepted)
        elseif(o IN_LIST D2_MODULE_${m}_SEES)
            continue()
        else()
            set(verdict violation)
        endif()
        set(p "${m}__${o}__${verdict}")
        if(NOT p IN_LIST _pairs)
            list(APPEND _pairs "${p}")
            set(TUS_${p})
            set(HDR_${p})
            set(EX_${p} "${tu} -> ${h}")
        endif()
        list(APPEND TUS_${p} "${tu}")
        list(APPEND HDR_${p} "${h}")
    endforeach()
endforeach()

# Internal includes: a file of module m including a header of a module it sees that is
# not that module's public header. Judged per include, against the including file.
foreach(f IN LISTS _all_files)
    _key(fk "${f}")
    set(m "${OWNER_${fk}}")
    if(NOT m OR m STREQUAL "(root)" OR D2_MODULE_${m}_KIND STREQUAL "ours" OR D2_MODULE_${m}_KIND STREQUAL "headers-only")
        continue()
    endif()
    foreach(inc IN LISTS INC_${fk})
        _key(ik "${inc}")
        set(o "${OWNER_${ik}}")
        if(NOT o OR o STREQUAL m OR o STREQUAL "(root)" OR NOT D2_MODULE_${o}_PUBLIC)
            continue()
        endif()
        if(inc STREQUAL D2_MODULE_${o}_PUBLIC)
            continue()
        endif()
        if(NOT o IN_LIST D2_MODULE_${m}_SEES AND NOT o IN_LIST D2_MODULE_${m}_EXCEPTIONS)
            continue()
        endif()
        if(o IN_LIST D2_MODULE_${m}_LOADS)
            set(p "${m}__${o}__load")
        else()
            set(p "${m}__${o}__internal")
        endif()
        if(NOT p IN_LIST _pairs)
            list(APPEND _pairs "${p}")
            set(TUS_${p})
            set(HDR_${p})
            set(EX_${p} "${f} -> ${inc}")
        endif()
        list(APPEND TUS_${p} "${f}")
        list(APPEND HDR_${p} "${inc}")
    endforeach()
endforeach()

# Via the root: headers globals.h pulls in that a module including it may not see.
foreach(m IN LISTS D2_MODULES)
    if(NOT USES_ROOT_${m} OR D2_MODULE_${m}_KIND STREQUAL "ours")
        continue()
    endif()
    foreach(h IN LISTS _root_closure)
        _key(hk "${h}")
        set(o "${OWNER_${hk}}")
        if(NOT o OR o STREQUAL m OR o STREQUAL "(root)" OR o IN_LIST D2_MODULE_${m}_SEES)
            continue()
        endif()
        set(p "${m}__${o}__via-root")
        if(NOT p IN_LIST _pairs)
            list(APPEND _pairs "${p}")
            set(TUS_${p})
            set(HDR_${p})
            set(EX_${p} "Source/globals/globals.h -> ${h}")
        endif()
        list(APPEND HDR_${p} "${h}")
    endforeach()
endforeach()

set(tsv "user\towner\tverdict\ttus\theaders\texample\n")
list(SORT _pairs)
foreach(p IN LISTS _pairs)
    string(REPLACE "__" ";" parts "${p}")
    list(GET parts 0 m)
    list(GET parts 1 o)
    list(GET parts 2 v)
    set(t ${TUS_${p}})
    set(h ${HDR_${p}})
    if(t)
        list(REMOVE_DUPLICATES t)
    endif()
    if(h)
        list(REMOVE_DUPLICATES h)
    endif()
    list(LENGTH t nt)
    list(LENGTH h nh)
    string(APPEND tsv "${m}\t${o}\t${v}\t${nt}\t${nh}\t${EX_${p}}\n")
    math(EXPR SUM_${m}_${v} "${SUM_${m}_${v}}+${nh}+0")
    math(EXPR PAIRS_${m}_${v} "${PAIRS_${m}_${v}}+1+0")
endforeach()
file(WRITE "${OUT}/module-gates.tsv" "${tsv}")

set(summary "module\tstrict\tviolation_pairs\tviolation_headers\texcepted_pairs\tvia_root_pairs\tinternal_pairs\tinternal_headers\tload_pairs\n")
set(lines)
set(strict_failed)
set(total_pairs 0)
set(total_internal 0)
set(clean)
foreach(m IN LISTS D2_MODULES)
    if(D2_MODULE_${m}_KIND STREQUAL "ours" OR D2_MODULE_${m}_KIND STREQUAL "headers-only" OR NOT D2_MODULE_${m}_GENERATED)
        continue()
    endif()
    foreach(v violation excepted via-root internal load)
        if(NOT DEFINED PAIRS_${m}_${v})
            set(PAIRS_${m}_${v} 0)
        endif()
        if(NOT DEFINED SUM_${m}_${v})
            set(SUM_${m}_${v} 0)
        endif()
    endforeach()
    set(s "${D2_MODULE_${m}_STRICT}")
    string(APPEND summary "${m}\t${s}\t${PAIRS_${m}_violation}\t${SUM_${m}_violation}\t${PAIRS_${m}_excepted}\t${PAIRS_${m}_via-root}\t${PAIRS_${m}_internal}\t${SUM_${m}_internal}\t${PAIRS_${m}_load}\n")
    math(EXPR total_pairs "${total_pairs}+${PAIRS_${m}_violation}")
    math(EXPR total_internal "${total_internal}+${PAIRS_${m}_internal}")
    if(PAIRS_${m}_violation EQUAL 0 AND PAIRS_${m}_internal EQUAL 0)
        list(APPEND clean "${m}")
    elseif(s)
        list(APPEND strict_failed "${m}")
    endif()
endforeach()
file(WRITE "${OUT}/module-gates-summary.tsv" "${summary}")

string(REPLACE ";" " " clean_text "${clean}")
message(STATUS "module gates: ${total_pairs} wrong-direction module pair(s), ${total_internal} internal-include pair(s); at 0: ${clean_text}")
message(STATUS "module gates: report ${OUT}/module-gates.tsv, per module ${OUT}/module-gates-summary.tsv")
if(strict_failed)
    string(REPLACE ";" " " failed_text "${strict_failed}")
    message(FATAL_ERROR "module gates: strict module(s) with a wrong-direction or internal include: ${failed_text} (see ${OUT}/module-gates.tsv)")
endif()
